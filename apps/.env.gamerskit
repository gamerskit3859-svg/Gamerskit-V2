# GamersKit — copy to .env.gamerskit and fill in ALL required values.
# Never commit the filled-in file.

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  BUILD-TIME  (NEXT_PUBLIC_*)                                                ║
# ║  These are baked into the Next.js client bundle at docker compose build.    ║
# ║  Changing any of them requires a full image rebuild.                        ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# REQUIRED — your production domain. nginx routes /api/* to Express,
# so NEXT_PUBLIC_API_URL is just the site origin (no /api suffix).
# Example: https://gamerskitbd.com
NEXT_PUBLIC_API_URL=https://gamerskitbd.com

# Optional — canonical site URL for SEO metadata. Defaults to https://gamerskitbd.com
NEXT_PUBLIC_SITE_URL=https://gamerskitbd.com

# Optional — Facebook Pixel ID for browser-side tracking (hardcoded fallback exists)
NEXT_PUBLIC_FB_PIXEL_ID=649455848240895

# Optional — Google Tag Manager container ID
NEXT_PUBLIC_GTM_ID=GTM-PRNKBXGN

# Optional — Google OAuth (web client ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=689990168769-l3lpar3ktpmf29vv97m6tlq06plk78el.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=https://gamerskitbd.com/auth/google/callback

# Optional — Facebook Login (app ID)
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Required for admin image upload — Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dtelttpwx
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=p1bog1hx


# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  RUNTIME — API server (Express)                                             ║
# ║  Injected at container start; never baked into an image.                    ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# REQUIRED — MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://gamerskit:mCp709rrZ85BgeMg@cluster0.y27spqp.mongodb.net/gamerskitv2?retryWrites=true&w=majority&appName=Cluster0

# REQUIRED — JWT signing secret (generate: openssl rand -hex 32)
JWT_SECRET=test-jwt-secret-for-build-only

# REQUIRED — Bootstrap admin account (created once on first API start)
# ADMIN_EMAIL=admin@gamerskit.local
ADMIN_PASSWORD=change-me-in-production

# Comma-separated allowed CORS origins for the API
CORS_ORIGIN=http://localhost:4200

# Facebook Conversions API (server-side)
FB_PIXEL_ID=649455848240895
FB_CAPI_TOKEN=
FB_TEST_EVENT_CODE=

# Google OAuth — server-side (different from NEXT_PUBLIC_GOOGLE_CLIENT_ID above)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook Login — server-side app credentials
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Steadfast courier API
STEADFAST_API_KEY=shpuc5bdzluucf6sbnpzk00pvkuwlhwn
STEADFAST_SECRET_KEY=yvdd8xau34hlhzmf9zgvqxr4
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1

# Cloudflare R2 — stores demo videos (/api/v1/gooblique/demo-videos).
# Fill these in before deploying; while blank, video upload routes return 503.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the bucket (custom domain or r2.dev), no trailing slash
R2_PUBLIC_URL=
# Optional — override the S3 endpoint (jurisdiction-specific R2, or MinIO in dev)
R2_ENDPOINT=


# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  INFRASTRUCTURE                                                             ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# Host port the nginx proxy binds to (default 80; use 443 after adding TLS)
HOST_PORT=4200
NEXT_PUBLIC_API_URL=http://localhost:4200
