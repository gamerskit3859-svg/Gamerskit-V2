# API workspace — copy to .env and fill in.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/gamerskit

# Long random string — used to sign JWTs
JWT_SECRET=replace-me-with-a-long-random-string

# Bootstrap admin credentials (created on first start if no admin exists)
ADMIN_EMAIL=admin@gamerskit.local
ADMIN_PASSWORD=admin123

# Comma-separated allowed origins. Each entry is either an exact origin
# (e.g. https://gamerskit-frontend.vercel.app) or a JavaScript regex
# wrapped in slashes (e.g. /^https:\/\/gamerskit-frontend-[\w-]+\.vercel\.app$/
# to allow Vercel preview deployments). "*" allows any origin.
# Includes:
#   - localhost dev ports: 3000 (Next default), 3010 (Next fallback), 5173 (Vite)
#   - production Vercel host
#   - all Vercel preview deployments
#   - the custom domain (apex + www)
CORS_ORIGIN=http://localhost:3000,http://localhost:3010,http://localhost:5173,https://gamerskit-frontend.vercel.app,/^https:\/\/gamerskit-frontend-[\w-]+\.vercel\.app$/,https://gamerskitbd.com,https://www.gamerskitbd.com

# Facebook Pixel + Conversions API (server-side)
# Get these from https://business.facebook.com/events_manager
FB_PIXEL_ID=
FB_CAPI_TOKEN=
# Optional: when set, events are flagged as test events in Events Manager
FB_TEST_EVENT_CODE=

# OAuth - Google Login
# Get these from https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - Facebook Login
# Get these from https://developers.facebook.com
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Source data API (used by `npm run seed` to import live gamerskitbd.com products)
GAMERSKIT_LEGACY_API=https://gamerskit-server.vercel.app

# Admin AI assistant (server-side only). Without a key the assistant returns 503.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# ── ChotoPaa read API (src/chotopaa, served at /api/chotopaa/v1) ────────────
# ChotoPaa's storefront (chotopaa.com) reads its catalogue from here. All of
# it is ChotoPaa's: its own Atlas cluster/user, never GamersKit's MONGODB_URI.
# Unset CHOTOPAA_MONGODB_URI = those routes answer 503; GamersKit is unaffected.
# A user with only the built-in `read` role on the chotopaa database.
CHOTOPAA_MONGODB_URI=
CHOTOPAA_DB_NAME=chotopaa
CHOTOPAA_CORS_ORIGINS=https://chotopaa.com,https://www.chotopaa.com
# Must equal STOCK_ENFORCEMENT / BKASH_NUMBER on ChotoPaa's backend.
CHOTOPAA_STOCK_ENFORCEMENT=true
CHOTOPAA_BKASH_NUMBER=
# Seconds a response is served from memory; ChotoPaa clears it on every write.
CHOTOPAA_CACHE_TTL_SECONDS=60
# Same value as READ_API_PURGE_SECRET on ChotoPaa's backend (both Vercel projects).
CHOTOPAA_PURGE_SECRET=
