# API workspace — copy to .env and fill in.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/gamerskit

# Long random string — used to sign JWTs
JWT_SECRET=replace-me-with-a-long-random-string

# Bootstrap admin credentials (created on first start if no admin exists)
ADMIN_EMAIL=admin@gamerskit.local
ADMIN_PASSWORD=admin123

# Comma-separated allowed origins. Each entry is either an exact origin
# (e.g. https://gamerskit-frontend.vercel.app) or a JavaScript regex
# wrapped in slashes (e.g. /^https:\/\/gamerskit-frontend-[\w-]+\.vercel\.app$/
# to allow Vercel preview deployments). "*" allows any origin.
# For local dev include both 3000 and 3010 because the storefront sometimes
# binds to 3010 when 3000 is in use.
CORS_ORIGIN=http://localhost:3000,http://localhost:3010,https://gamerskit-frontend.vercel.app,/^https:\/\/gamerskit-frontend-[\w-]+\.vercel\.app$/

# Facebook Pixel + Conversions API (server-side)
# Get these from https://business.facebook.com/events_manager
FB_PIXEL_ID=
FB_CAPI_TOKEN=
# Optional: when set, events are flagged as test events in Events Manager
FB_TEST_EVENT_CODE=

# OAuth - Google Login
# Get these from https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - Facebook Login
# Get these from https://developers.facebook.com
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Source data API (used by `npm run seed` to import live gamerskitbd.com products)
GAMERSKIT_LEGACY_API=https://gamerskit-server.vercel.app
