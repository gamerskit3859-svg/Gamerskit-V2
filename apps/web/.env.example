# Web workspace — copy to .env.local and fill in.

# Public URL of the API service (used by Server Components + browser fetches)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Same Pixel ID as the API uses, but exposed to the browser
NEXT_PUBLIC_FB_PIXEL_ID=

# Optional: Google Tag Manager container ID for richer data layer routing
NEXT_PUBLIC_GTM_ID=

# Cloudinary cloud name (e.g. "my-cloud") — required for product image upload
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Unsigned upload preset for the admin product image uploader.
# Create at https://console.cloudinary.com/settings/upload (Upload presets → Add).
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
